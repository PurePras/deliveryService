# Deployment-level config for docker-compose.prod.yml. Copy to `.env` on the server
# (next to docker-compose.prod.yml) and fill in real values — see docs/DEPLOYMENT.md.
# This is separate from backend/.env, which is only for local `go run` dev.

# --- Postgres (internal to the Docker network — never exposed to the host) ---
POSTGRES_USER=shri_ram
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=shri_ram_service

# --- Backend ---
DATABASE_URL=postgres://shri_ram:change-me-to-a-real-password@db:5432/shri_ram_service?sslmode=disable
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret
COOKIE_SECURE=true
CORS_ALLOWED_ORIGIN=https://your-domain.example
LOG_FORMAT=json
OTP_TTL_MINUTES=5
# Leave unset/false here — this prints OTP codes to the server log, which is only
# acceptable for local dev (backend/.env).
OTP_DEV_LOG_CODES=false
# Real SMS delivery (internal/sms.MSG91Sender) — set both to actually send OTPs.
# Takes priority over OTP_DEV_LOG_CODES when both are set. TemplateID must be a
# DLT-approved MSG91 Flow template with one variable named OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- nginx / HTTPS (used by scripts/init-letsencrypt.sh) ---
DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=you@example.com
