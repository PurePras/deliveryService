# Postgres container config (used by docker-compose.yml)
POSTGRES_USER=shri_ram
POSTGRES_PASSWORD=shri_ram
POSTGRES_DB=shri_ram_service
# Host port to map to Postgres's container port 5432.
# 5432/5433 are already taken by native PostgreSQL installs on this machine, so default to 5434.
POSTGRES_PORT=5434
ADMINER_PORT=8081

# Backend app config
DATABASE_URL=postgres://shri_ram:shri_ram@localhost:5434/shri_ram_service?sslmode=disable
PORT=8080

# Auth
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -base64 32
JWT_SECRET=dev-only-change-me
# Set to true once served over https (production) — an httpOnly cookie marked Secure is
# dropped by browsers over plain http, so this must stay false for local dev.
COOKIE_SECURE=false
CORS_ALLOWED_ORIGIN=http://localhost:5173

# "text" (default, readable in a local terminal) or "json" (for a log aggregator in production)
LOG_FORMAT=text

# OTP login (see internal/service/auth_service.go RequestLoginOTP/VerifyLoginOTP)
# How long a generated code stays valid.
OTP_TTL_MINUTES=5
# No real SMS provider is wired in yet (see internal/sms) — this prints codes to the
# server log so login is testable locally. NEVER set this to true in production.
OTP_DEV_LOG_CODES=true
